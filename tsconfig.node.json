{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo.node.json"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "playwright.packaged.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "e2e/**/*",
    "scripts/**/*"
  ]
}
